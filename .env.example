# This is a sample .env; the real .env is never committed (see .gitignore).
# Nothing here is required for a local dry run:  python main.py --city Essen --no-teams

# Results card → the channel the whole team reads
TEAMS_WEBHOOK_URL=

# Diagnostics card → a private dev channel (optional; falls back to the log)
TEAMS_DEV_WEBHOOK_URL=

# AI relevance filter — off unless set to true (then the AZURE_OPENAI_* values are needed)
ENABLE_AI_FILTER=false
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
